# PostChef — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# Supabase (auth + persistance)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (Claude) — analyse IA + Vision
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Whisper ASR + DALL-E images)
OPENAI_API_KEY=sk-...

# Shotstack (rendu vidéo)
SHOTSTACK_API_KEY=...
SHOTSTACK_HOST=https://api.shotstack.io/edit/stage

# Pexels (stock footage B-roll)
PEXELS_API_KEY=...

# Google Places (Restaurant Brain)
GOOGLE_PLACES_API_KEY=...

# Cloudinary (upload CDN — optionnel si Shotstack Ingest indisponible)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_UNSIGNED_UPLOAD_PRESET=...
